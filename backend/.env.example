# ─────────────────────────────────────────────
# AutoOps 配置文件与 HTTP 服务
# ─────────────────────────────────────────────
AUTOOPS_ENV_FILE=.env
AUTOOPS_SERVER_HOST=localhost
AUTOOPS_SERVER_PORT=8819

# ─────────────────────────────────────────────
# Embedding 向量模型
# ─────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30s
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_NORMALIZE=true

# ─────────────────────────────────────────────
# LLM（OpenAI-compatible Chat API）
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=minimax/minimax-m2.1
OPENAI_API_BASE=https://api.qnaigc.com/v1

# ─────────────────────────────────────────────
# Qdrant 向量数据库
# ─────────────────────────────────────────────
AUTOOPS_QDRANT_HOST=127.0.0.1
AUTOOPS_QDRANT_PORT=6334
AUTOOPS_QDRANT_COLLECTION=autoops

# ─────────────────────────────────────────────
# Prometheus 告警服务
# ─────────────────────────────────────────────
PROMETHEUS_URL=http://127.0.0.1:30900

# ─────────────────────────────────────────────
# Kubernetes / Minikube 集群观测
# ─────────────────────────────────────────────
AUTOOPS_K8S_ENABLED=true
AUTOOPS_K8S_KUBECONFIG=
AUTOOPS_K8S_CONTEXT=minikube
AUTOOPS_K8S_NAMESPACE=autoops-test
AUTOOPS_K8S_IN_CLUSTER=false

# ─────────────────────────────────────────────
# 后台告警监听与自动修复策略
# ─────────────────────────────────────────────
AUTOOPS_BACKGROUND_ENABLED=true
AUTOOPS_BACKGROUND_POLL_INTERVAL=30s
AUTOOPS_BACKGROUND_NAMESPACE=autoops-test
AUTOOPS_AUTO_REPAIR_ENABLED=true
AUTOOPS_AUTO_REPAIR_ALERTS=AutoOpsPodRestartHigh,AutoOpsPodNotReady
AUTOOPS_SEVERE_ALERTS=AutoOpsServiceUnavailable,AutoOpsDeploymentUnavailable
AUTOOPS_AUTO_REPAIR_MAX_RESTARTS=3
AUTOOPS_AUTO_REPAIR_COOLDOWN=10m

# ─────────────────────────────────────────────
# Incident Agent 受控修复
# ─────────────────────────────────────────────
AUTOOPS_INCIDENT_ACTIONS_ENABLED=true
AUTOOPS_INCIDENT_ALLOWED_ACTIONS=delete_managed_pod,rollout_restart_deployment,rollback_deployment,scale_deployment
AUTOOPS_INCIDENT_MAX_REPLICAS=3
AUTOOPS_INCIDENT_REQUIRE_CONFIRMATION=true
AUTOOPS_INCIDENT_AGENT_TIMEOUT=5m
AUTOOPS_INCIDENT_WORKER_TIMEOUT=75s

# ─────────────────────────────────────────────
# AutoOps 日志
# ─────────────────────────────────────────────
AUTOOPS_LOG_LEVEL=info
AUTOOPS_LOG_FILE=log/AutoOps.log

# ─────────────────────────────────────────────
# Prometheus 测试服务场景
# ─────────────────────────────────────────────
AUTOOPS_TEST_SCENARIO=alert

TZ=Asia/Shanghai

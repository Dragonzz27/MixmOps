# Copy to .env and fill secrets locally.
AUTOOPS_ENV_FILE=.env
AUTOOPS_SERVER_HOST=localhost
AUTOOPS_SERVER_PORT=8819
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30s
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_NORMALIZE=true
OPENAI_API_KEY=
OPENAI_MODEL=minimax/minimax-m2.1
OPENAI_API_BASE=https://api.qnaigc.com/v1
AUTOOPS_QDRANT_HOST=127.0.0.1
AUTOOPS_QDRANT_PORT=6334
AUTOOPS_QDRANT_COLLECTION=autoops
PROMETHEUS_URL=http://127.0.0.1:30900
AUTOOPS_K8S_ENABLED=true
AUTOOPS_K8S_KUBECONFIG=
AUTOOPS_K8S_CONTEXT=minikube
AUTOOPS_K8S_NAMESPACE=autoops-test
AUTOOPS_K8S_IN_CLUSTER=false
AUTOOPS_LOG_LEVEL=info
AUTOOPS_LOG_FILE=log/AutoOps.log
AUTOOPS_TEST_SCENARIO=alert
TZ=Asia/Shanghai
